{
  "name": "Week Calendar",
  "author": "Alexander Sohr",
  "description": "Termine der Woche (Mo–So) aus mehreren ICS-Kalendern, mit Vor/Zurück-Navigation. Daten kommen aus dem Item WeekCalendar_Json (JS-Regel week-calendar.js).",
  "source_url": "https://raw.githubusercontent.com/also90/week-calendar/master/widget/week-calendar.json",
  "readme_url": "https://github.com/also90/week-calendar",
  "template": "<div style=\"height:100%\" oc-lazy-load=\"{files: ['/static/week-calendar/week-calendar.js'], cache: false}\">\n  <div style=\"height:100%\" ng-controller=\"WeekCalendarCtrl as wc\">\n    <div style=\"height:100%\" ng-include=\"wc.tpl\"></div>\n  </div>\n</div>\n",
  "settings": [
    {
      "type": "item",
      "id": "item",
      "label": "JSON-Item",
      "default": "WeekCalendar_Json"
    },
    {
      "type": "color",
      "id": "highlight",
      "label": "Akzentfarbe (heute/Titel)",
      "default": "#4fc3f7"
    },
    {
      "type": "number",
      "id": "fontSize",
      "label": "Schriftgröße (px)",
      "default": 14
    },
    {
      "type": "checkbox",
      "id": "showLocation",
      "label": "Ort anzeigen",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "showLegend",
      "label": "Legende anzeigen",
      "default": true
    }
  ]
}