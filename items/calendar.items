//WeekDay Groups
Group CurDate
Group CurCalMon
Group CurCalTue
Group CurCalWed
Group CurCalThu
Group CurCalFri
Group CurCalSat
Group CurCalSun

//Personal (user) Calendar Groups
Group FamilyCal
Group AlexCal
Group DeliCal
Group NinaCal

//FeatureTags
//Summary, Location, StartTime, EndTime

Number          CurrentWeek             "aktuelle Woche [%]" (Time, CurDate)

DateTime	CurCal_Mon_Date	"Datum  [%1$td.%1$tm.%1$tY]"	<calendar> (CurCalMon, CurDate)  ["Date"]
