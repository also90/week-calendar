// Week Calendar – wird von automation/js/week-calendar.js befüllt
// Enthält die Termine der aktuellen Woche (Mo–So) als JSON für das HABPanel-Widget
String  WeekCalendar_Json     "Wochenkalender (JSON)"         <calendar>
Switch  WeekCalendar_Refresh  "Wochenkalender aktualisieren"  <calendar>   // ON = lädt gerade, Regel setzt danach OFF
